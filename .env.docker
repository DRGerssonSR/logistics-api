# ==========================================
# Configuración para Docker Compose
# ==========================================
# Usar con: docker compose --env-file .env.docker up -d

# PostgreSQL (Docker Compose)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=produser
DB_PASSWORD=prodpass123
DB_NAME=logistics_prod
DB_SYNCHRONIZE=true
DB_LOGGING=false

# MongoDB (Docker Compose)
MONGODB_URI=mongodb://mongodb:27017/logistics_tracking_prod

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Application
PORT=3000
NODE_ENV=production

# ==========================================
# NOTA: Estos valores coinciden con los defaults del docker-compose.yml
# - PostgreSQL: localhost:5434 (externa) -> postgres:5432 (interna)
# - MongoDB: localhost:27019 (externa) -> mongodb:27017 (interna)
# - API: localhost:3001 (externa) -> app:3000 (interna)
# ==========================================
