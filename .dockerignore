.env
.env.local
.env.*.local
.env.production
.env.development

# Git
.git
.gitignore
.gitattributes

# Documentación
README.md
MVP.md
*.md
docs

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Testing
coverage
.nyc_output
*.log
test

# OS
.DS_Store
Thumbs.db

# Otros
.eslintcache
.prettierignore
eslint.config.mjs

